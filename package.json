    "@mui/material": "^5.14.0",
    "@mui/x-date-pickers": "^5.0.0-alpha.6",
    "@playwright/test": "^1.63.0",
    "@prisma/client": "5.8.0",
    "axios": "^1.6.0",
    "clsx": "2.1.0",
    "date-fns": "2.30.0",
    "lucide-react": "0.296.0",
    "next": "14.2.3",
    "next-auth": "^5.0.0-beta.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.51.2",
